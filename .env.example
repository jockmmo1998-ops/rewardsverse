# ===================================================

# RewardsVerse - Environment Variables

# Copy file này thành .env và điền giá trị thật

# ===================================================



# --- BẮT BUỘC ---

# Supabase PostgreSQL connection URI for Render + Drizzle migrations.
# Use the official Supabase Session Pooler URI (port 5432) or Direct URI when
# the Render network supports IPv6. Never commit the real password here.
DATABASE_URL=



# Secret key để ký JWT session cookie (tạo random string dài ít nhất 32 ký tự)

JWT_SECRET=your-super-secret-jwt-key-change-this-now-min-32-chars



# App ID (đặt tên bất kỳ, VD: rewardsverse)

VITE_APP_ID=rewardsverse



# --- TÙY CHỌN (để trống nếu không dùng Manus OAuth) ---

OAUTH_SERVER_URL=

OWNER_OPEN_ID=

VITE_OAUTH_PORTAL_URL=



# --- Manus Storage (để trống nếu không dùng) ---

BUILT_IN_FORGE_API_URL=

BUILT_IN_FORGE_API_KEY=



# --- Node environment ---

NODE_ENV=production

# --- Offerwall placements and postback secrets ---
# Keep real values in Render Environment Variables; never commit them.
GEMIWALL_OFFERWALL_URL=
GEMIWALL_PLACEMENT_ID=
GEMIWALL_POSTBACK_SECRET=
REVTOO_OFFERWALL_URL=
REVTOO_PLACEMENT_ID=
REVTOO_API_KEY=
REVTOO_POSTBACK_SECRET=
CLICKWALL_OFFERWALL_URL=
CLICKWALL_PLACEMENT_ID=
CLICKWALL_POSTBACK_SECRET=
MOUSTACHE_OFFERWALL_URL=
MOUSTACHE_PLACEMENT_ID=
MOUSTACHE_API_KEY=
MOUSTACHE_POSTBACK_SECRET=
TASKWALL_APP_ID=
TASKWALL_POSTBACK_SECRET=
COINTO_OFFERWALL_URL=
COINTO_PUBLIC_KEY=
COINTO_PLACEMENT_ID=
COINTO_POSTBACK_SECRET=
KLINK_PUBLISHER_ID=
KLINK_POSTBACK_SECRET=
ADSWEDMEDIA_OFFERWALL_URL=
ADSWEDMEDIA_PUBLIC_KEY=
ADSWEDMEDIA_PLACEMENT_ID=
ADSWEDMEDIA_POSTBACK_SECRET=
ADMAXFLOW_OFFERWALL_URL=
ADMAXFLOW_PLACEMENT_ID=
ADMAXFLOW_POSTBACK_SECRET=
ADMAXFLOW_CURRENCY_RATE=400
# TimeWall Placement > Postback Setup: the secret shown by TimeWall.
TIMEWALL_POSTBACK_SECRET=
# TimeWall Placement ID and exact points-per-USD rate from the active Placement.
TIMEWALL_PLACEMENT_ID=
TIMEWALL_POINTS_PER_USD=
# Gaintwall's Placement API key from Publisher > Placements.
GAINTWALL_API_KEY=
GAINTWALL_PLACEMENT_KEY=
# Optional; when absent, the API key is used as the documented fallback secret.
GAINTWALL_POSTBACK_SECRET=
BUCKSWALL_OFFERWALL_URL=
BUCKSWALL_POSTBACK_SECRET=
# CPX Research app 35865; secure hash is from CPX Publisher > Apps > Rewardsverse.
CPX_APP_ID=35865
CPX_APP_SECURE_HASH=
CPX_OFFERWALL_URL=https://offers.cpx-research.com/index.php
THEOREMREACH_APP_ID=25491
THEOREMREACH_API_KEY=
THEOREMREACH_SECRET_KEY=
THEOREMREACH_OFFERWALL_URL=https://theoremreach.com/respondent_entry/direct


# --- Secure admin promotion ---
# Set a random secret (at least 8 characters) in deployment environment variables.
# Use the authenticated Admin Login flow to promote an existing account.
ADMIN_SECRET=

# Public origin used to build provider callback URLs.
PUBLIC_APP_URL=https://rewardsverse.online

# Revtoo featured offers feed, if enabled in the deployment.
REVTOO_API_KEY=
